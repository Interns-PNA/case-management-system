# MongoDB connection string (Atlas SRV or local).
# Include a database name, e.g. /case_management — without it Mongoose uses the "test" DB.
MONGO_URI=mongodb://localhost:27017/case_management
# Legacy alias still supported by the code:
# MongoURI=

# Port the API listens on (Container Apps uses 8080)
PORT=5000

# Comma-separated CORS allowlist. Leave empty to allow all origins (dev only).
ALLOWED_ORIGINS=http://localhost:5173

# Password for the initial "admin" user. The user is created only if it does
# not exist yet; an existing admin password is NEVER reset on startup.
ADMIN_INITIAL_PASSWORD=admin1

# production | development
NODE_ENV=development
