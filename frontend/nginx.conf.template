server {
  listen       80;
  server_name  _;

  root   /usr/share/nginx/html;
  index  index.html;

  # Backend API. ${BACKEND_URL} is injected at container start, e.g.
  # http://cms-backend.internal.<env>.azurecontainerapps.io
  location /api/ {
    proxy_pass              ${BACKEND_URL};
    proxy_http_version      1.1;
    proxy_set_header        Host $host;
    proxy_set_header        X-Real-IP $remote_addr;
    proxy_set_header        X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header        X-Forwarded-Proto $scheme;
    proxy_read_timeout      120s;
    client_max_body_size    25m;
  }

  # Backend health endpoint (also used by CI smoke tests)
  location = /health {
    proxy_pass              ${BACKEND_URL};
    proxy_http_version      1.1;
    proxy_set_header        Host $host;
  }

  # Uploaded case files are served by the backend
  location /uploads/ {
    proxy_pass              ${BACKEND_URL};
    proxy_http_version      1.1;
    proxy_set_header        Host $host;
    proxy_set_header        X-Real-IP $remote_addr;
    proxy_set_header        X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header        X-Forwarded-Proto $scheme;
    proxy_read_timeout      120s;
    client_max_body_size    25m;
  }

  # SPA fallback for client-side routes (/dashboard, /cases, ...)
  location / {
    try_files $uri $uri/ /index.html;
  }
}
