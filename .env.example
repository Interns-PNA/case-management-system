# Copy to .env and fill in the values. Never commit .env.
# Docker Compose reads this file automatically.

# Required — MongoDB connection string.
# Atlas:  mongodb+srv://user:pass@cluster0.ov0ojvy.mongodb.net/case_management?retryWrites=true&w=majority
# Local (with --profile local): mongodb://mongo:27017/case_management
MONGO_URI=

# Optional overrides
# ADMIN_INITIAL_PASSWORD=admin1
# ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
